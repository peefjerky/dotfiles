# Browser data and caches
config/thorium/
config/chromium/
config/google-chrome/
config/zen/
config/.zen/

# Application state / databases
config/spicetify/Backups/
config/spicetify/.cache/

# Secrets and keys
*.pem
*.key
*.asc
id_rsa
id_ed25519

# Fish shell compiled bytecode and history
config/fish/fish_history
config/fish/*.bak

# Neovim plugins and state (managed by lazy.nvim / mason)
config/nvim/lazy-lock.json
config/nvim/plugin/
config/nvim/.git/

# mpv: uosc ships ~17 MB of prebuilt binaries per platform. Plugin, not config.
config/mpv/scripts/
config/mpv/fonts/
config/mpv/watch_later/

# caelestia's config dir carries an inert .git (no commits, no remote).
# Nesting it would make this a broken submodule.
config/caelestia/.git/

# Large binary / cache directories
config/btop/themes/.git/
config/easyeffects/irs/

# Logs
*.log

# OS noise
.DS_Store
Thumbs.db

# Staging artifacts
dotfiles-staging/
