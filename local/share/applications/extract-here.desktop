[Desktop Entry]
Type=Application
Name=Extract Here
Comment=Unpack the archive into a folder beside it
Exec=/home/peefjerky/.local/bin/extract-here %F
Icon=package-x-generic
Terminal=false
MimeType=application/zip;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-tar;application/x-compressed-tar;application/x-bzip-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/gzip;application/x-gtar;
