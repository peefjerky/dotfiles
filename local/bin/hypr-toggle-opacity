#!/bin/sh
# Toggle the focused window between its normal opacity and a clearly
# transparent one.
#
# WHY NOT THE "opaque" TAG (the first version): caelestia keys opacity off that
# tag, but custom/rules.lua tags the terminal with it BY CLASS. A rule-applied
# tag shows as "opaque*" and cannot be removed by hand, so on kitty -- the most
# likely window to try this on -- the toggle silently did nothing.
#
# setprop overrides window rules, so it works on every window including the
# terminal. `opacity` is the current prop name; `alpha` was renamed in 0.53+ and
# now errors with "Invalid prop name". Value -1 means "unset, revert to whatever
# the rules say", which is how the OFF state restores 0.95 (or the terminal's
# opaque) rather than hardcoding a number.
#
# The state marker is our own tag, deliberately NOT "opaque": that name is
# caelestia's and is rule-applied on some windows, which is the bug above.
#
# 0.80 rather than something near 0.95 on purpose -- the old toggle moved 0.05,
# and across a delta that small no animation duration is distinguishable from
# an instant change.
set -eu

TAG=xparent
LEVEL=0.80

tags=$(hyprctl activewindow -j | tr -d ' \n' | grep -o '"tags":\[[^]]*\]' || true)

case "$tags" in
    *"$TAG"*)
        hyprctl dispatch 'hl.dsp.window.set_prop({ prop = "opacity", value = "-1" })' >/dev/null
        hyprctl dispatch "hl.dsp.window.tag({ tag = \"-$TAG\" })" >/dev/null
        ;;
    *)
        hyprctl dispatch "hl.dsp.window.set_prop({ prop = \"opacity\", value = $LEVEL })" >/dev/null
        hyprctl dispatch "hl.dsp.window.tag({ tag = \"+$TAG\" })" >/dev/null
        ;;
esac
