#!/bin/sh
# Toggle the focused window between its normal opacity and fully opaque.
#
# Uses Hyprland's dedicated boolean prop `opaque`, not `opacity`. That matters:
# `opacity` takes a float and is the same knob caelestia's windowOpacity rule
# drives, so setting it fights the rule and a wrong value blanks the window.
# `opaque` is a flag -- 1 forces solid, 0 restores whatever the rules say -- so
# there is no value to get wrong and nothing to reset numerically.
# (The Lua binding wants a number: value = true is rejected, value = 1 is not.)
#
# Not the "opaque" TAG: caelestia rule-tags the terminal with that by class, and
# a rule-applied tag cannot be removed by hand, so the toggle was a no-op there.
# State lives on our own `forceopaque` tag instead.
#
# Terminal is deliberately opaque already via custom/rules.lua; pressing this
# there does nothing, which is correct.
set -eu

TAG=forceopaque

tags=$(hyprctl activewindow -j | tr -d ' \n' | grep -o '"tags":\[[^]]*\]' || true)

case "$tags" in
    *"$TAG"*)
        hyprctl dispatch 'hl.dsp.window.set_prop({ prop = "opaque", value = 0 })' >/dev/null
        hyprctl dispatch "hl.dsp.window.tag({ tag = \"-$TAG\" })" >/dev/null
        ;;
    *)
        hyprctl dispatch 'hl.dsp.window.set_prop({ prop = "opaque", value = 1 })' >/dev/null
        hyprctl dispatch "hl.dsp.window.tag({ tag = \"+$TAG\" })" >/dev/null
        ;;
esac
