#!/bin/sh
# Toggle the focused window's transparency.
#
# Caelestia already drives opacity off a window tag: hyprland/rules.lua:16-22
# defines create_tag("opaque", ...) as a window_rule matching { tag = "opaque" },
# and windowOpacity (0.95) applies to everything else. So this needs no rule of
# its own -- it flips the tag and lets the existing rule do the work.
#
# Deliberately no python: the first version parsed the JSON with `python3 -c`,
# and interpreter startup alone was 15 ms of the script's 32 ms, which read as a
# lag between the keypress and the fade starting. Pure shell is ~4 ms.
#
# The trailing "*" on a tag means it was applied by a rule rather than by hand
# (kitty gets one from custom/rules.lua), so match the bare name to catch both.
set -eu

tags=$(hyprctl activewindow -j | tr -d ' \n' | grep -o '"tags":\[[^]]*\]' || true)

case "$tags" in
    *opaque*) hyprctl dispatch 'hl.dsp.window.tag({ tag = "-opaque" })' >/dev/null ;;
    *)        hyprctl dispatch 'hl.dsp.window.tag({ tag = "+opaque" })' >/dev/null ;;
esac
