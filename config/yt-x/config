# List of extensions to load automatically on startup
# See extensions/cmds/no-gum.sh -- it stops yt-x using gum, whose terminal
# capability probes leak their replies into fzf's input.
CONFIG_AUTOLOADED_EXTENSIONS="cmds/no-gum.sh"

# Enable or disable colored/formatted output
# Options: true, false (Default: true)
CONFIG_ENABLE_COLORS="true"

# The menu launcher tool used for the ui
# Options: fzf, rofi, gum (Default: fzf)
CONFIG_LAUNCHER="fzf"

# Enable image/video previews within the selector
# Options: true, false (Default: false)
CONFIG_ENABLE_PREVIEW="true"
CONFIG_ENABLE_PREVIEW_IMAGES="true"

# The tool used to render previews in the terminal
# Options: chafa, icat, imgcat (Default: chafa)
# chafa, not icat. Both can drive the kitty graphics protocol, but icat has to
# ask the terminal for its pixel size and hard-errors if nothing answers -- and
# inside an fzf preview nothing reliably does, because fzf owns the tty reader.
# The stolen replies then get echoed as literal text in the search bar.
# chafa can be told the protocol outright and skip probing entirely, which is
# what ~/.config/yt-x/fzf-preview.sh does. Image quality is identical: both end
# up sending the same APC _G graphics escape.
CONFIG_IMAGE_RENDERER="chafa"

# Extra arguments for specific image renderers
CONFIG_CHAFA_ARGS=""
CONFIG_ICAT_ARGS=""
CONFIG_IMGCAT_ARGS=""

# custom opts for yt-dlp
CONFIG_YT_DLP_OPTS=""

# The media player used for playback
# Options: mpv, vlc, tplay (Default: mpv)
CONFIG_PLAYER="mpv"

# Extra arguments for specific media players
# Always 1080p, never AV1. This machine is an Ice Lake Iris Plus G7, which
# decodes VP9 and H.264 in hardware but has no AV1 block at all (vainfo lists
# VAProfileVP9Profile0-3 and no AV1 profile), so an av01 stream would fall back
# to the CPU -- fans up, battery down, for the same picture. Excluding it lands
# on VP9 248, which is what YouTube serves at 1080p anyway.
# The two fallbacks matter: some videos have no non-AV1 1080p, and a few are
# muxed-only, so bail to bestvideo+bestaudio and then to a progressive stream.
#
# The cookie handoff is separate from CONFIG_BROWSER below, because that one
# only reaches yt-dlp when yt-x fetches metadata; mpv resolves the stream URL
# itself through its ytdl_hook. Without this, member-only and age-gated videos
# in the subscriptions feed list fine and then refuse to play.
CONFIG_MPV_ARGS="--ytdl-format=bestvideo[height<=?1080][vcodec!*=av01]+bestaudio/bestvideo[height<=?1080]+bestaudio/best[height<=?1080]/best --ytdl-raw-options=cookies-from-browser=firefox:$HOME/.local/state/yt-x/zen-profile"
CONFIG_VLC_ARGS=""
CONFIG_TPLAY_ARGS=""

# Name of the activity to launch on Android. Useful if you are using a fork with a different activity name
CONFIG_PLAYER_MPV_ANDROID_ACTIVITY_NAME=""
CONFIG_PLAYER_VLC_ANDROID_ACTIVITY_NAME=""

# Whether to disown the player, process to prevent blocking the UI
# options: true, false (Default: false)
CONFIG_DISOWN_PLAYER="false"

# Maximum number of search results to fetch per page
# Options: Integer (Default: 30)
CONFIG_PER_PAGE="30"

# Browser for yt-dlp to get cookies from
# passed to --cookies-from-browser yt-dlp option
# Currently supported browsers are: brave, chrome, chromium, edge, firefox, opera, safari, vivaldi, whale
# NOTE: this option is entirely dependent on what yt-dlp supports
# Zen is a Firefox fork, so yt-dlp reads it with the firefox backend pointed at
# an explicit profile path -- "zen" is not one of the names yt-dlp knows, and the
# profile does not live under ~/.mozilla/firefox where a bare profile name would
# be looked up. The real profile is "~/.config/zen/miffdfiy.Default (release)";
# the symlink exists only because that name has spaces in it and yt-x splats
# $CONFIG_BROWSER unquoted into its yt-dlp argv (yt-x:2056, yt-x:2291).
#
# psd keeps the profile on tmpfs and leaves a symlink behind, so this is a
# symlink to a symlink -- resolved lazily, so a psd resync does not break it.
# Sync the subscription list with: Miscellaneous -> Sync YouTube Subscriptions.
CONFIG_BROWSER="firefox:$HOME/.local/state/yt-x/zen-profile"

# Text editor for manual configuration/metadata editing
# Options: vim, nano, code ... (Default: $EDITOR or vi)
CONFIG_EDITOR="vi"

# The terminal to use to execute commands that require a terminal
CONFIG_TERMINAL_EXEC=""

# Duration in seconds for desktop notifications
CONFIG_NOTIFICATION_DURATION="5"

# Directory where downloads are saved
# Default: /home/peefjerky/Videos/yt-x
CONFIG_DOWNLOAD_DIR="/home/peefjerky/Videos/yt-x"
CONFIG_DOWNLOADS_ENUMERATE="false"

# Automatically check for script updates on startup
# Options: true, false (Default: true)
CONFIG_CHECK_FOR_UPDATES="true"

# Number of items to keep in the recent history
CONFIG_NO_OF_RECENT="10"

# Enable or disable saving search queries to history
# Options: true, false (Default: true)
CONFIG_ENABLE_SEARCH_HISTORY="true"

# Custom options passed directly to gum
CONFIG_GUM_OPTS="--prompt.foreground #2ac3de --indicator.foreground #2ac3de --selected-indicator.foreground #2ac3de --unselected-prefix.foreground #585858 --header.foreground #2ac3de --text.foreground #c0caf5 --cursor-text.foreground #c0caf5 --match.foreground #2ac3de --placeholder.foreground #585858  --prompt  > --indicator ◆ --selected-prefix  ◉  --unselected-prefix  ○  --placeholder こんにちは..."
CONFIG_GUM_INPUT_OPTS="--prompt.foreground #2ac3de --cursor.foreground #c0caf5 --placeholder こんにちは... --cursor.mode blink"
CONFIG_GUM_PAGER_OPTS="--foreground #c0caf5 --line-number.foreground #585858 --match.foreground #2ac3de --match-highlight.foreground #1a1b26 --match-highlight.background #2ac3de --help.foreground #585858 --show-line-numbers --soft-wrap --border-foreground #2ac3de"
CONFIG_GUM_SPIN_OPTS="--spinner dot --spinner.foreground #2ac3de --title.foreground #585858  --align left"
CONFIG_GUM_CONFIRM_OPTS="--prompt.foreground #2ac3de --selected.foreground #1a1b26 --selected.background #2ac3de --unselected.foreground #585858"

# Custom options passed directly to fzf
CONFIG_FZF_HEADER="\
"
CONFIG_FZF_OPTS="
  --ansi
  # Colours live in extensions/themes/default.theme, which tracks the caelestia
  # wallpaper scheme through the terminal palette. Do not re-add --color here.
  # Run preview subprocesses under sh, not $SHELL. fzf defaults to $SHELL, which
  # here is fish, and yt-x's preview preamble is POSIX -- fish rejects the bare
  # VAR='...' assignments outright (yt-x:1247-1255). CONFIG_FZF_OPTS reaches fzf
  # through the exported FZF_DEFAULT_OPTS, which fzf parses with real quoting, so
  # the quotes below survive; they would not on argv.
  --with-shell='sh -c'
  --border
  --scheme=history
  --style=full
  --border=rounded
  --border-label=''
  --prompt=' >'
  --marker=' >'
  --pointer='◆'
  --layout=reverse
  --cycle
  --ghost='こんにちは...'
  --height=100%
  --bind=ctrl-/:toggle-preview,ctrl-space:toggle-wrap+toggle-preview-wrap
  --no-margin
  +m
  -i
  --exact
  --tabstop=1
  --preview-window=border-rounded,left,45%,wrap
  --wrap"

# Rofi config all are required to run rofi as a launcher
# get the official ones from https://github.com/Benexl/yt-x
CONFIG_ROFI_THEME_MAIN=""
CONFIG_ROFI_THEME_PREVIEW=""
CONFIG_ROFI_THEME_PROMPT=""
CONFIG_ROFI_THEME_CONFIRM=""
CONFIG_ROFI_THEME_PAGER=""

# Number of days to keep cached preview images, playlists, and logs
# Default: 3
CONFIG_CACHE_RETENTION_DAYS="3"
